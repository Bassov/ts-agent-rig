{
  "name": "@albasov/ts-agent-rig",
  "version": "0.2.15",
  "description": "Agent pipeline, roadmap CLI, and quality-gate harness for TypeScript repos",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "bin": {
    "agent": "./bin/agent.mjs",
    "roadmap": "./bin/roadmap.mjs",
    "ts-rig-check": "./bin/check.mjs",
    "ts-rig-gate": "./bin/gate.mjs",
    "ts-rig-ci": "./bin/ci.mjs"
  },
  "exports": {
    ".": "./src/load-gates.mjs",
    "./load-gates": {
      "types": "./src/load-gates.d.mts",
      "default": "./src/load-gates.mjs"
    },
    "./package.json": "./package.json",
    "./e2e-flaky-list": "./src/e2e-flaky-list.mjs",
    "./hook-clean-env": "./src/hook-clean-env.mjs",
    "./strip-git-env": "./src/strip-git-env.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:pack-smoke": "node ./scripts/pack-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:host": "vitest run --config vitest.host.config.mjs"
  },
  "dependencies": {
    "typescript": "~5.9.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@vitest/coverage-v8": "^5.0.4",
    "fast-check": "^4.10.2",
    "vitest": "^5.0.4",
    "@types/node": "^24.13.3"
  }
}
